    "5db402c171740647575da1108949579d3331851a773f854243d14df8241e8e38": {
      "url": "https://www.fedinprint.org/item/fedlwp/102353/103009",
      "title": "Expectations on Wealth Returns: Implications for Labor Supply During the Retirement Boom",
      "district": "St. Louis Fed (8th District)",
      "districtCode": "STL",
      "contentType": "Working Papers",
      "publicationDate": "2026-04-08",
      "authors": [],
